{
  "name": "listenin",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @listenin/web dev & pnpm --filter @listenin/api dev",
    "dev:web": "pnpm --filter @listenin/web dev",
    "dev:api": "pnpm --filter @listenin/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "db:migrate": "pnpm --filter @listenin/api prisma migrate dev",
    "db:generate": "pnpm --filter @listenin/api prisma generate",
    "db:studio": "pnpm --filter @listenin/api prisma studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  }
}
