generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────

enum RoomVisibility {
  PRIVATE
  PUBLIC
}

enum RoomRole {
  HOST
  MODERATOR
  LISTENER
}

enum MessageType {
  TEXT
  VOICE_NOTE
}

enum SuggestionStatus {
  PENDING
  PLAYED
  SKIPPED
}

// ─── Models ───────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  avatarUrl    String?
  passwordHash String?
  googleId            String?  @unique
  spotifyAccessToken  String?
  spotifyRefreshToken String?
  createdAt           DateTime @default(now())

  hostedRooms    Room[]            @relation("RoomHost")
  memberships    RoomMember[]
  chatMessages   ChatMessage[]
  suggestions    QueueSuggestion[]

  @@map("users")
}

model Room {
  id         String         @id @default(uuid())
  name       String
  hostId     String
  visibility RoomVisibility @default(PRIVATE)
  inviteCode String         @unique
  createdAt  DateTime       @default(now())

  host        User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members     RoomMember[]
  messages    ChatMessage[]
  suggestions QueueSuggestion[]

  @@map("rooms")
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  role     RoomRole @default(LISTENER)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_members")
}

model ChatMessage {
  id        String      @id @default(uuid())
  roomId    String
  userId    String
  type      MessageType @default(TEXT)
  content   String?
  audioUrl  String?
  createdAt DateTime    @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model QueueSuggestion {
  id          String           @id @default(uuid())
  roomId      String
  suggestedBy String
  title       String
  artist      String?
  coverUrl    String?
  audioUrl    String?
  sourceUrl   String?
  duration    Int?
  status      SuggestionStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  room           Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  suggestedByUser User @relation(fields: [suggestedBy], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@map("queue_suggestions")
}
